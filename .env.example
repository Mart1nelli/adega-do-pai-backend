# copy this file to `.env` and fill in real credentials before running the
# application. environment variables are loaded by @nestjs/config (if
# configured) and by Prisma automatically.

DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"
# optional shadow DB used by `prisma migrate` when using
# `--shadow-database-url` or when you configure `shadowDatabaseUrl` in
# schema.prisma under the datasource block (see docs).
# SHADOW_DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/SHADOW_DB?schema=public"

# example additional Prisma configuration via environment variables:
# PRISMA_LOG_LEVEL="query,info,warn,error"

JWT_SECRET=your_jwt_secret_here
